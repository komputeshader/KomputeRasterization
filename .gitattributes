# Set the default behavior for files without an explicit rule.
* text=auto

# Normalize text files in Git and use CRLF in the working tree.
*.gitattributes text eol=crlf
*.editorconfig text eol=crlf
*.gitignore text eol=crlf
*.gitmodules text eol=crlf
*.config text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.c text eol=crlf
*.h text eol=crlf
*.cpp text eol=crlf
*.hpp text eol=crlf
*.hlsl text eol=crlf
*.hlsli text eol=crlf
LICENSE text eol=crlf

*.sln text eol=crlf
*.vcxproj* text eol=crlf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
